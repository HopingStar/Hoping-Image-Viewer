{
  // 默认图片目录：留空 = 自动定位到仓库根目录下的 pictures/（向上查找 .sln 确定仓库根）。
  // 也可改成绝对路径，如 "D:\\Libraries\\PictureFloder\\图片"。前端路径栏仍可浏览任意本地目录。
  "Images": {
    "Root": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

<Window x:Class="ImageViewer.App.FastViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hoping Image Viewer"
        Width="1000" Height="700" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="#1b1e24"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">

    <Window.Resources>
        <!-- 极速查看器工具栏按钮：极简深色圆角 -->
        <Style x:Key="FastToolBtn" TargetType="Button">
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="Background" Value="#2c323b" />
            <Setter Property="Foreground" Value="#d7dde6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3a4250" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#23272f" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 极简顶栏：文件名（fill 剩余）+ 旋转/缩放/适应 + 回到相册 -->
        <Border DockPanel.Dock="Top" Background="#23272f" Padding="10,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="btnBack" Content="🏠 回到相册" Click="ReturnToGallery_Click"
                            Style="{StaticResource FastToolBtn}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="fitBtn" Content="⛶" Click="Fit_Click" Style="{StaticResource FastToolBtn}" />
                    <Button x:Name="zoomOutBtn" Content="➖" Click="ZoomOut_Click" Style="{StaticResource FastToolBtn}" />
                    <Button x:Name="zoomInBtn" Content="➕" Click="ZoomIn_Click" Style="{StaticResource FastToolBtn}" />
                    <Button x:Name="rotLBtn" Content="↺" Click="RotateLeft_Click" Style="{StaticResource FastToolBtn}" />
                    <Button x:Name="rotRBtn" Content="↻" Click="RotateRight_Click" Style="{StaticResource FastToolBtn}" />
                    <Button x:Name="bgBtn" Content="▦" Click="Bg_Click" Style="{StaticResource FastToolBtn}" />
                </StackPanel>
                <TextBlock x:Name="fileNameText" VerticalAlignment="Center" Foreground="#d7dde6"
                           FontSize="13" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <!-- 图片画布：滚轮缩放 / 拖拽平移 / 双击切换 1×-适应 -->
        <Grid x:Name="canvas" Background="#1b1e24" ClipToBounds="True"
              SizeChanged="canvas_SizeChanged"
              MouseWheel="canvas_MouseWheel"
              MouseLeftButtonDown="canvas_MouseLeftButtonDown"
              MouseMove="canvas_MouseMove"
              MouseLeftButtonUp="canvas_MouseLeftButtonUp">
            <Image x:Name="img" Stretch="Uniform" Margin="24" RenderOptions.BitmapScalingMode="HighQuality"
                   RenderTransformOrigin="0.5,0.5" Visibility="Hidden">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="scale" />
                        <RotateTransform x:Name="rotate" />
                        <TranslateTransform x:Name="translate" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Grid>
    </DockPanel>
</Window>

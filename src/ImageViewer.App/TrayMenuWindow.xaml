<Window x:Class="ImageViewer.App.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="菜单"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Topmost="True"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="Microsoft YaHei UI" FontSize="13">

    <Window.Resources>
        <!-- 托盘菜单项：圆角 hover 高亮的透明按钮 -->
        <Style x:Key="TrayMenuBtn" TargetType="Button">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="#d7dde6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3a4250" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2c323b" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 深色圆角面板 + 阴影，四周留边让阴影可见 -->
    <Border x:Name="Root" CornerRadius="10" Margin="18" Padding="6"
            Background="#23272f" BorderBrush="#3a4250" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <StackPanel Width="190">
            <TextBlock Text="Hoping Image Viewer" Margin="10,8,10,8" FontWeight="Bold"
                       Foreground="#e6ebf2" FontSize="12.5" />
            <Border Height="1" Background="#343b46" Margin="8,0" />
            <Button Style="{StaticResource TrayMenuBtn}" Click="Open_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📂" Margin="0,0,9,0" />
                    <TextBlock x:Name="openText" Text="打开主界面" />
                </StackPanel>
            </Button>
            <Button x:Name="FlashBtn" Style="{StaticResource TrayMenuBtn}" Click="Flash_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡" Margin="0,0,9,0" />
                    <TextBlock x:Name="flashText" Text="Flash 查看器" />
                </StackPanel>
            </Button>
            <Border Height="1" Background="#343b46" Margin="8,2" />
            <Button Style="{StaticResource TrayMenuBtn}" Click="Exit_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✕" Margin="0,0,9,0" Foreground="#f87171" />
                    <TextBlock x:Name="exitText" Text="退出" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
